<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <title><%= data ? data.course + " - 授業詳細" : "授業が見つかりません" %></title>
  <link rel="stylesheet" href="/public/app.css">
  <script src="/public/classes_detail.js" defer></script>
</head>
<body>
  <% if (!data) { %>
    <h2>授業が見つかりません</h2>
    <p>指定された ID（<%= id %>）の授業データは存在しません。</p>
    <a href="/classes" class="btn">授業一覧に戻る</a>
  <% } else { %>
    <div id="class-detail-root" data-id="<%= data.id %>">
      <h2 id="detail-heading"><%= data.course %> の詳細</h2>
      <div id="status-message" class="status-message" aria-live="polite"></div>

      <table>
        <tr><th>項目</th><th>データ</th></tr>
        <tr><td>ID</td><td id="detail-id"><%= data.id %></td></tr>
        <tr><td>科目名</td><td id="detail-course"><%= data.course %></td></tr>
        <tr><td>曜日</td><td id="detail-day"><%= data.day %></td></tr>
        <tr><td>時限</td><td id="detail-period"><%= data.period %></td></tr>
        <tr><td>教室</td><td id="detail-room"><%= data.room %></td></tr>
        <tr><td>担当教員</td><td id="detail-teacher"><%= data.teacher || "未設定" %></td></tr>
        <tr><td>単位数</td><td id="detail-credits"><%= data.credits %></td></tr>
        <tr><td>メモ</td><td id="detail-memo"><%= data.memo || "なし" %></td></tr>
      </table>

      <h3>授業情報の変更</h3>
      <form id="class-edit-form">
        <div class="form-group">
          <label for="edit-course">科目名</label>
          <input type="text" id="edit-course" name="course" value="<%= data.course %>" required>
        </div>
        <div class="form-group">
          <label for="edit-day">曜日</label>
          <input type="text" id="edit-day" name="day" value="<%= data.day %>" required>
        </div>
        <div class="form-group">
          <label for="edit-period">時限</label>
          <input type="text" id="edit-period" name="period" value="<%= data.period %>" required>
        </div>
        <div class="form-group">
          <label for="edit-room">教室</label>
          <input type="text" id="edit-room" name="room" value="<%= data.room %>" required>
        </div>
        <div class="form-group">
          <label for="edit-teacher">担当教員</label>
          <input type="text" id="edit-teacher" name="teacher" value="<%= data.teacher %>">
        </div>
        <div class="form-group">
          <label for="edit-credits">単位数</label>
          <input type="number" id="edit-credits" name="credits" min="1" max="10" value="<%= data.credits %>" required>
        </div>
        <div class="form-group">
          <label for="edit-memo">メモ</label>
          <textarea id="edit-memo" name="memo" rows="3"><%= data.memo %></textarea>
        </div>
        <div class="actions">
          <button type="submit" class="btn btn-primary">変更を保存</button>
          <button type="button" id="delete-btn" class="btn btn-danger">この授業を削除</button>
          <a href="/classes" class="btn">授業一覧に戻る</a>
        </div>
      </form>
    </div>
  <% } %>
</body>
</html>
