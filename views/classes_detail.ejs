<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <title><%= data ? data.course + " - 授業詳細" : "授業が見つかりません" %></title>
  <link rel="stylesheet" href="/public/app.css">
</head>
<body>
  <% if (!data) { %>
    <h2>授業が見つかりません</h2>
    <p>指定された ID（<%= id %>）の授業データは存在しません。</p>
    <a href="/classes" class="btn">授業一覧に戻る</a>
  <% } else { %>
    <h2><%= data.course %> の詳細</h2>

    <table class="detail-table">
      <tr>
        <th>項目</th>
        <th>データ</th>
      </tr>
      <tr>
        <th>ID</th>
        <td><%= data.id %></td>
      </tr>
      <tr>
        <th>科目名</th>
        <td><%= data.course %></td>
      </tr>
      <tr>
        <th>曜日</th>
        <td><%= data.day %></td>
      </tr>
      <tr>
        <th>時限</th>
        <td><%= data.period %></td>
      </tr>
      <tr>
        <th>教室</th>
        <td><%= data.room %></td>
      </tr>
      <tr>
        <th>担当教員</th>
        <td><%= data.teacher || "未設定" %></td>
      </tr>
      <tr>
        <th>単位数</th>
        <td><%= data.credits %></td>
      </tr>
      <tr>
        <th>メモ</th>
        <td><%= data.memo || "なし" %></td>
      </tr>
    </table>

    <div class="actions">
      <a href="/classes/edit/<%= data.id %>" class="btn btn-primary">編集</a>
      <a href="/classes/delete/<%= data.id %>" class="btn btn-danger">削除</a>
      <a href="/classes" class="btn">授業一覧に戻る</a>
    </div>
  <% } %>
</body>
</html>
