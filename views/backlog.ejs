<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <title>積みゲー・積読リスト</title>
  <link rel="stylesheet" href="/public/app.css">
  <script src="/public/backlog.js" defer></script>
</head>
<body>
  <h2>積みゲー・積読リスト</h2>

  <%
    const pendingHours = data
      .filter((item) => item.status === "未着手" || item.status === "進行中")
      .reduce((sum, item) => sum + Number(item.estimatedHours || 0), 0);
  %>
  <div id="summary-bar" class="summary-bar">
    表示件数: <span id="summary-count"><%= data.length %></span> 件 / 未消化の想定時間: <span id="summary-hours"><%= pendingHours %></span> 時間
  </div>

  <div class="actions">
    <a href="/public/backlog_add.html" class="btn btn-primary">＋ 新しいアイテムを追加する</a>
    <button type="button" id="reload-btn">一覧を再取得</button>
  </div>

  <div class="filter-bar">
    <label for="filter-type">種別:</label>
    <select id="filter-type">
      <option value="">すべて</option>
      <% for (let t of types) { %>
        <option value="<%= t %>"><%= t %></option>
      <% } %>
    </select>

    <label for="filter-status">ステータス:</label>
    <select id="filter-status">
      <option value="">すべて</option>
      <% for (let s of statuses) { %>
        <option value="<%= s %>"><%= s %></option>
      <% } %>
    </select>

    <label for="filter-keyword">検索:</label>
    <input type="text" id="filter-keyword" placeholder="タイトル・媒体・メモ">
    <button type="button" id="reset-filter-btn">条件クリア</button>
  </div>

  <div id="status-message" class="status-message" aria-live="polite"></div>

  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>タイトル</th>
        <th>種別</th>
        <th>媒体</th>
        <th>積み年数</th>
        <th>想定時間</th>
        <th>ステータス</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody id="backlog-tbody">
      <% if (data.length === 0) { %>
        <tr>
          <td colspan="8">登録されているアイテムはありません。</td>
        </tr>
      <% } else { %>
        <% for (let row of data) { %>
          <tr>
            <td><%= row.id %></td>
            <td><a href="/backlog/<%= row.id %>"><%= row.title %></a></td>
            <td><%= row.type %></td>
            <td><%= row.platform %></td>
            <td><%= row.yearsStacked %>年</td>
            <td><%= row.estimatedHours %>時間</td>
            <td><%= row.status %></td>
            <td class="actions">
              <a href="/backlog/<%= row.id %>" class="btn">詳細・編集</a>
              <button
                type="button"
                class="btn btn-danger delete-btn"
                data-id="<%= row.id %>"
                data-title="<%= row.title %>"
              >削除</button>
            </td>
          </tr>
        <% } %>
      <% } %>
    </tbody>
  </table>
</body>
</html>
