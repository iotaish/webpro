<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <title>積みゲー・積読リスト</title>
  <link rel="stylesheet" href="/public/app.css">
</head>
<body>
  <h2>積みゲー・積読リスト</h2>

  <%
    const pendingHours = data
      .filter((item) => item.status === "未着手" || item.status === "進行中")
      .reduce((sum, item) => sum + Number(item.estimatedHours || 0), 0);
  %>
  <div class="summary-bar">
    表示件数: <%= data.length %> 件 / 未消化の想定時間: <%= pendingHours %> 時間
  </div>

  <div class="actions">
    <a href="/backlog/create" class="btn btn-primary">＋ 新しいアイテムを追加する</a>
  </div>

  <form action="/backlog" method="GET" class="filter-bar">
    <label for="filter-type">種別:</label>
    <select id="filter-type" name="type">
      <option value="">すべて</option>
      <% for (let t of types) { %>
        <option value="<%= t %>" <%= type === t ? "selected" : "" %>><%= t %></option>
      <% } %>
    </select>

    <label for="filter-status">ステータス:</label>
    <select id="filter-status" name="status">
      <option value="">すべて</option>
      <% for (let s of statuses) { %>
        <option value="<%= s %>" <%= status === s ? "selected" : "" %>><%= s %></option>
      <% } %>
    </select>

    <label for="filter-keyword">検索:</label>
    <input type="text" id="filter-keyword" name="q" value="<%= q %>" placeholder="タイトル・媒体・メモ">
    <button type="submit" class="btn">絞り込み</button>
    <a href="/backlog" class="btn">条件クリア</a>
  </form>

  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>タイトル</th>
        <th>種別</th>
        <th>媒体</th>
        <th>積み年数</th>
        <th>想定時間</th>
        <th>ステータス</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody>
      <% if (data.length === 0) { %>
        <tr>
          <td colspan="8">登録されているアイテムはありません。</td>
        </tr>
      <% } else { %>
        <% for (let row of data) { %>
          <tr>
            <td><%= row.id %></td>
            <td><a href="/backlog/<%= row.id %>"><%= row.title %></a></td>
            <td><%= row.type %></td>
            <td><%= row.platform %></td>
            <td><%= row.yearsStacked %>年</td>
            <td><%= row.estimatedHours %>時間</td>
            <td><%= row.status %></td>
            <td class="actions">
              <a href="/backlog/<%= row.id %>" class="btn">詳細</a>
              <a href="/backlog/edit/<%= row.id %>" class="btn">編集</a>
              <a href="/backlog/delete/<%= row.id %>" class="btn btn-danger">削除</a>
            </td>
          </tr>
        <% } %>
      <% } %>
    </tbody>
  </table>
</body>
</html>
