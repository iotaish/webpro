<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <title>授業一覧</title>
  <link rel="stylesheet" href="/public/app.css">
</head>
<body>
  <h2>授業一覧</h2>

  <%
    const totalCredits = data.reduce((sum, item) => sum + Number(item.credits || 0), 0);
  %>
  <div class="summary-bar">
    表示件数: <%= data.length %> 件 / 合計単位数: <%= totalCredits %> 単位
  </div>

  <div class="actions">
    <a href="/classes/create" class="btn btn-primary">＋ 新しい授業を追加する</a>
  </div>

  <form action="/classes" method="GET" class="filter-bar">
    <label for="filter-day">曜日:</label>
    <select id="filter-day" name="day">
      <option value="">すべて</option>
      <% for (let d of days) { %>
        <option value="<%= d %>" <%= day === d ? "selected" : "" %>><%= d %></option>
      <% } %>
    </select>

    <label for="filter-keyword">検索:</label>
    <input type="text" id="filter-keyword" name="q" value="<%= q %>" placeholder="科目名・教室・教員・メモ">
    <button type="submit" class="btn">絞り込み</button>
    <a href="/classes" class="btn">条件クリア</a>
  </form>

  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>科目名</th>
        <th>曜日</th>
        <th>時限</th>
        <th>教室</th>
        <th>単位</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody>
      <% if (data.length === 0) { %>
        <tr>
          <td colspan="7">登録されている授業はありません。</td>
        </tr>
      <% } else { %>
        <% for (let row of data) { %>
          <tr>
            <td><%= row.id %></td>
            <td><a href="/classes/<%= row.id %>"><%= row.course %></a></td>
            <td><%= row.day %></td>
            <td><%= row.period %></td>
            <td><%= row.room %></td>
            <td><%= row.credits %></td>
            <td class="actions">
              <a href="/classes/<%= row.id %>" class="btn">詳細</a>
              <a href="/classes/edit/<%= row.id %>" class="btn">編集</a>
              <a href="/classes/delete/<%= row.id %>" class="btn btn-danger">削除</a>
            </td>
          </tr>
        <% } %>
      <% } %>
    </tbody>
  </table>
</body>
</html>
