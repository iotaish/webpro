<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <title>授業一覧</title>
  <link rel="stylesheet" href="/public/app.css">
  <script src="/public/classes.js" defer></script>
</head>
<body>
  <h2>授業一覧</h2>

  <%
    const totalCredits = data.reduce((sum, item) => sum + Number(item.credits || 0), 0);
  %>
  <div id="summary-bar" class="summary-bar">
    表示件数: <span id="summary-count"><%= data.length %></span> 件 / 合計単位数: <span id="summary-credits"><%= totalCredits %></span> 単位
  </div>

  <div class="actions">
    <a href="/public/classes_add.html" class="btn btn-primary">＋ 新しい授業を追加する</a>
    <button type="button" id="reload-btn">一覧を再取得</button>
  </div>

  <div class="filter-bar">
    <label for="filter-day">曜日:</label>
    <select id="filter-day">
      <option value="">すべて</option>
      <% for (let d of days) { %>
        <option value="<%= d %>"><%= d %></option>
      <% } %>
    </select>

    <label for="filter-keyword">検索:</label>
    <input type="text" id="filter-keyword" placeholder="科目名・教室・教員・メモ">
    <button type="button" id="reset-filter-btn">条件クリア</button>
  </div>

  <div id="status-message" class="status-message" aria-live="polite"></div>

  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>科目名</th>
        <th>曜日</th>
        <th>時限</th>
        <th>教室</th>
        <th>単位</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody id="classes-tbody">
      <% if (data.length === 0) { %>
        <tr>
          <td colspan="7">登録されている授業はありません。</td>
        </tr>
      <% } else { %>
        <% for (let row of data) { %>
          <tr>
            <td><%= row.id %></td>
            <td><a href="/classes/<%= row.id %>"><%= row.course %></a></td>
            <td><%= row.day %></td>
            <td><%= row.period %></td>
            <td><%= row.room %></td>
            <td><%= row.credits %></td>
            <td class="actions">
              <a href="/classes/<%= row.id %>" class="btn">詳細・編集</a>
              <button
                type="button"
                class="btn btn-danger delete-btn"
                data-id="<%= row.id %>"
                data-course="<%= row.course %>"
              >削除</button>
            </td>
          </tr>
        <% } %>
      <% } %>
    </tbody>
  </table>
</body>
</html>
