<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <title><%= data ? data.title + " - 詳細" : "アイテムが見つかりません" %></title>
  <link rel="stylesheet" href="/public/app.css">
</head>
<body>
  <% if (!data) { %>
    <h2>アイテムが見つかりません</h2>
    <p>指定された ID（<%= id %>）のデータは存在しません。</p>
    <a href="/backlog" class="btn">一覧に戻る</a>
  <% } else { %>
    <h2><%= data.title %> の詳細</h2>

    <table class="detail-table">
      <tr>
        <th>項目</th>
        <th>データ</th>
      </tr>
      <tr>
        <th>ID</th>
        <td><%= data.id %></td>
      </tr>
      <tr>
        <th>タイトル</th>
        <td><%= data.title %></td>
      </tr>
      <tr>
        <th>種別</th>
        <td><%= data.type %></td>
      </tr>
      <tr>
        <th>媒体・プラットフォーム</th>
        <td><%= data.platform %></td>
      </tr>
      <tr>
        <th>積み年数</th>
        <td><%= data.yearsStacked %>年</td>
      </tr>
      <tr>
        <th>想定所要時間</th>
        <td><%= data.estimatedHours %>時間</td>
      </tr>
      <tr>
        <th>ステータス</th>
        <td><%= data.status %></td>
      </tr>
      <tr>
        <th>メモ</th>
        <td><%= data.memo || "なし" %></td>
      </tr>
    </table>

    <div class="actions">
      <a href="/backlog/edit/<%= data.id %>" class="btn btn-primary">編集</a>
      <a href="/backlog/delete/<%= data.id %>" class="btn btn-danger">削除</a>
      <a href="/backlog" class="btn">一覧に戻る</a>
    </div>
  <% } %>
</body>
</html>
