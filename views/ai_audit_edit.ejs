<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <title><%= data ? data.serviceName + " - 編集" : "監査データが見つかりません" %></title>
  <link rel="stylesheet" href="/public/app.css">
</head>
<body>
  <% if (!data) { %>
    <h2>監査データが見つかりません</h2>
    <p>指定された ID（<%= id %>）のデータは存在しません。</p>
    <a href="/ai-audit" class="btn">一覧に戻る</a>
  <% } else { %>
    <h2><%= data.serviceName %> の編集</h2>

    <% if (error) { %>
      <div class="status-message error" role="alert"><%= error %></div>
    <% } %>

    <form action="/ai-audit/update/<%= data.id %>" method="POST">
      <table class="detail-table">
        <tr>
          <th>項目</th>
          <th>データ</th>
        </tr>
        <tr>
          <th>ID</th>
          <td><%= data.id %></td>
        </tr>
        <tr>
          <th><label for="edit-serviceName">サービス・プラン名</label></th>
          <td><input type="text" id="edit-serviceName" name="serviceName" value="<%= data.serviceName %>" required></td>
        </tr>
        <tr>
          <th><label for="edit-modelId">利用モデル</label></th>
          <td>
            <select id="edit-modelId" name="modelId" required>
              <% for (let m of models) { %>
                <option value="<%= m.id %>" <%= Number(data.modelId) === Number(m.id) ? "selected" : "" %>>
                  <%= m.provider %> / <%= m.modelName %>（<%= m.grade %>: $<%= Number(m.inputPricePer1M).toFixed(2) %> / $<%= Number(m.outputPricePer1M).toFixed(2) %>）
                </option>
              <% } %>
            </select>
          </td>
        </tr>
        <tr>
          <th><label for="edit-billingCycle">契約周期</label></th>
          <td>
            <select id="edit-billingCycle" name="billingCycle" required>
              <% for (let c of billingCycles) { %>
                <option value="<%= c %>" <%= data.billingCycle === c ? "selected" : "" %>><%= c %></option>
              <% } %>
            </select>
          </td>
        </tr>
        <tr>
          <th><label for="edit-contractFeeUsd">契約額（USD）</label></th>
          <td><input type="number" id="edit-contractFeeUsd" name="contractFeeUsd" min="0" max="10000" step="0.01" value="<%= data.contractFeeUsd %>" required></td>
        </tr>
        <tr>
          <th><label for="edit-inputTokensM">月間入力トークン数（M）</label></th>
          <td><input type="number" id="edit-inputTokensM" name="inputTokensM" min="0" max="10000" step="0.01" value="<%= data.inputTokensM %>" required></td>
        </tr>
        <tr>
          <th><label for="edit-outputTokensM">月間出力トークン数（M）</label></th>
          <td><input type="number" id="edit-outputTokensM" name="outputTokensM" min="0" max="10000" step="0.01" value="<%= data.outputTokensM %>" required></td>
        </tr>
        <tr>
          <th><label for="edit-status">監査ステータス</label></th>
          <td>
            <select id="edit-status" name="status" required>
              <% for (let s of statuses) { %>
                <option value="<%= s %>" <%= data.status === s ? "selected" : "" %>><%= s %></option>
              <% } %>
            </select>
          </td>
        </tr>
        <tr>
          <th><label for="edit-memo">監査メモ</label></th>
          <td><textarea id="edit-memo" name="memo" rows="3"><%= data.memo %></textarea></td>
        </tr>
      </table>

      <div class="actions">
        <button type="submit" class="btn btn-primary">変更を保存</button>
        <a href="/ai-audit/<%= data.id %>" class="btn">詳細に戻る</a>
        <a href="/ai-audit" class="btn">一覧に戻る</a>
      </div>
    </form>
  <% } %>
</body>
</html>
